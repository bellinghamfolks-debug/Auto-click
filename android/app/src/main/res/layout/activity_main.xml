<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="4dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="20dp" />

        <!-- Status display (live region) -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@color/surface"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/status_ready"
            android:accessibilityLiveRegion="polite"
            android:layout_marginBottom="20dp" />

        <!-- Four big main action buttons -->
        <Button
            android:id="@+id/btnDescribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:text="@string/btn_describe"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/describe"
            android:textColor="@color/on_primary"
            android:contentDescription="@string/btn_describe_desc"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:text="@string/btn_read"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/read"
            android:textColor="@color/on_primary"
            android:contentDescription="@string/btn_read_desc"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnAsk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:text="@string/btn_ask"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/ask"
            android:textColor="@color/on_primary"
            android:contentDescription="@string/btn_ask_desc"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:text="@string/btn_translate"
            android:textSize="22sp"
            android:textStyle="bold"
            android:backgroundTint="@color/translate"
            android:textColor="@color/on_primary"
            android:contentDescription="@string/btn_translate_desc"
            android:layout_marginBottom="24dp" />

        <!-- Secondary controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnRepeat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/btn_repeat"
                android:textSize="14sp"
                android:backgroundTint="@color/surface_elevated"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/btn_repeat" />

            <Button
                android:id="@+id/btnStopSpeech"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/btn_stop_speech"
                android:textSize="14sp"
                android:backgroundTint="@color/surface_elevated"
                android:textColor="@color/text_primary"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/btn_stop_speech" />
        </LinearLayout>

        <!-- Result area -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result_label"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:paddingBottom="6dp"
            android:accessibilityHeading="true" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:padding="16dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/last_action_none"
            android:textIsSelectable="true"
            android:accessibilityLiveRegion="polite"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_settings"
            android:textSize="15sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/btn_settings" />

    </LinearLayout>
</ScrollView>
