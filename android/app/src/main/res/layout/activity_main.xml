<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="start"
            android:paddingBottom="6dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="20dp" />

        <!-- ============ Status Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_status_label"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/serviceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/service_status_disabled"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exec_status_label"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/execStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/exec_status_idle"
            android:accessibilityLiveRegion="polite" />

        <!-- ============ Coordinates Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_coords"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true" />

        <TextView
            android:labelFor="@+id/inputLikeX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_like_x"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputLikeX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_like_x" />

        <TextView
            android:labelFor="@+id/inputLikeY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_like_y"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputLikeY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_like_y" />

        <TextView
            android:labelFor="@+id/inputYesX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_yes_x"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputYesX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_yes_x" />

        <TextView
            android:labelFor="@+id/inputYesY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_yes_y"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputYesY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_yes_y" />

        <!-- Close button coordinates (NEW) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingTop="14dp"
            android:paddingBottom="4dp" />

        <TextView
            android:labelFor="@+id/inputCloseX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_close_x"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="4dp" />
        <EditText
            android:id="@+id/inputCloseX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_close_x" />

        <TextView
            android:labelFor="@+id/inputCloseY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_close_y"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputCloseY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_coord"
            android:textSize="18sp"
            android:contentDescription="@string/label_close_y" />

        <!-- ============ Timing Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_timing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true" />

        <TextView
            android:labelFor="@+id/inputDelayLike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_delay_after_like"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputDelayLike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_delay_1s"
            android:textSize="18sp"
            android:contentDescription="@string/label_delay_after_like" />

        <TextView
            android:labelFor="@+id/inputDelayYes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_delay_after_yes"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputDelayYes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_delay_2s"
            android:textSize="18sp"
            android:contentDescription="@string/label_delay_after_yes" />

        <TextView
            android:labelFor="@+id/inputDelayClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_delay_after_close"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputDelayClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_delay_1s"
            android:textSize="18sp"
            android:contentDescription="@string/label_delay_after_close" />

        <TextView
            android:labelFor="@+id/inputRepeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_repeat"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputRepeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_repeat"
            android:textSize="18sp"
            android:contentDescription="@string/label_repeat" />

        <!-- ============ Scroll Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_scroll"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true" />

        <CheckBox
            android:id="@+id/checkScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/label_scroll"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:buttonTint="@color/primary"
            android:contentDescription="@string/label_scroll" />

        <TextView
            android:labelFor="@+id/inputScrollDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_scroll_distance"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputScrollDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_scroll_distance"
            android:textSize="18sp"
            android:contentDescription="@string/label_scroll_distance" />

        <!-- ============ Actions Section ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="24dp"
            android:paddingBottom="12dp"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/btn_start"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/success"
            android:textColor="@color/on_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/btn_stop"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/stop_red"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_stop" />

        <Button
            android:id="@+id/btnTestLike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_test_like"
            android:textSize="17sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_test_like" />

        <Button
            android:id="@+id/btnTestYes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_test_yes"
            android:textSize="17sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_test_yes" />

        <Button
            android:id="@+id/btnTestClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_test_close"
            android:textSize="17sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_test_close" />

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_open_accessibility"
            android:textSize="17sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_open_accessibility" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_reset"
            android:textSize="17sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/btn_reset" />

    </LinearLayout>

</ScrollView>
