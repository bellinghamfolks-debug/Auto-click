<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="6dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:paddingBottom="20dp" />

        <!-- ===== Status Section ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/service_status_label"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/serviceStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/service_status_disabled"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exec_status_label"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/execStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="@string/exec_status_idle"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/counter_label"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/counterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@color/surface"
            android:textColor="@color/success"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="0"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_action_label"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/lastActionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@color/surface"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:text="@string/last_action_none"
            android:accessibilityLiveRegion="polite" />

        <!-- ===== Configuration Section ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_config"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="14dp" />

        <TextView
            android:labelFor="@+id/inputLikeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_like_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputLikeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:hint="@string/hint_like_text"
            android:textSize="18sp"
            android:contentDescription="@string/label_like_text" />

        <TextView
            android:labelFor="@+id/inputYesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_yes_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputYesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:hint="@string/hint_yes_text"
            android:textSize="18sp"
            android:contentDescription="@string/label_yes_text" />

        <TextView
            android:labelFor="@+id/inputCloseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_close_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="8dp" />
        <EditText
            android:id="@+id/inputCloseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:hint="@string/hint_close_text"
            android:textSize="18sp"
            android:contentDescription="@string/label_close_text" />

        <TextView
            android:labelFor="@+id/inputTargetPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_target_package"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/inputTargetPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:hint="@string/hint_target_package"
            android:textSize="16sp"
            android:contentDescription="@string/label_target_package" />

        <TextView
            android:labelFor="@+id/inputProfileKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_profile_keywords"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/inputProfileKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="text"
            android:hint="@string/hint_profile_keywords"
            android:textSize="16sp"
            android:contentDescription="@string/label_profile_keywords" />

        <TextView
            android:labelFor="@+id/inputScanInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_scan_interval"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/inputScanInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_scan_interval"
            android:textSize="18sp"
            android:contentDescription="@string/label_scan_interval" />

        <TextView
            android:labelFor="@+id/inputPopupWait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_popup_wait"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/inputPopupWait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_popup_wait"
            android:textSize="18sp"
            android:contentDescription="@string/label_popup_wait" />

        <TextView
            android:labelFor="@+id/inputIdleTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_idle_timeout"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/inputIdleTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="number"
            android:hint="@string/hint_idle_timeout"
            android:textSize="18sp"
            android:contentDescription="@string/label_idle_timeout" />

        <!-- ===== Actions Section ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:paddingTop="28dp"
            android:paddingBottom="12dp"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/btn_start"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/success"
            android:textColor="@color/on_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/btn_stop"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/stop_red"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_stop" />

        <Button
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_open_accessibility"
            android:textSize="17sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/btn_open_accessibility" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/btn_reset"
            android:textSize="17sp"
            android:backgroundTint="@color/surface_elevated"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/btn_reset" />

    </LinearLayout>

</ScrollView>
