<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">مكفوف بوت</string>
    <string name="service_label">بوت ذكي للمكفوفين</string>
    <string name="service_description">يقرأ التطبيق شجرة عناصر الشاشة عبر إذن إمكانية الوصول للبحث عن أزرار يحددها المستخدم بنفسه ونقرها برمجيًا. يعمل بدقة كاملة بدون إحداثيات ولا روت ولا تجاوز حماية أي تطبيق.</string>

    <string name="header_title">مكفوف بوت - بوت ذكي بدون إحداثيات</string>
    <string name="header_subtitle">يقرأ الشاشة ويبحث عن الأزرار وينقرها تلقائيًا. لا حاجة لتشغيل TalkBack.</string>

    <!-- ===== Status ===== -->
    <string name="section_status">حالة التطبيق</string>
    <string name="service_status_label">حالة خدمة إمكانية الوصول</string>
    <string name="service_status_enabled">مفعلة</string>
    <string name="service_status_disabled">غير مفعلة - اضغط زر فتح إعدادات إمكانية الوصول</string>
    <string name="exec_status_label">حالة التنفيذ</string>
    <string name="exec_status_idle">خامل</string>
    <string name="exec_status_running">يعمل</string>
    <string name="exec_status_stopped">متوقف</string>
    <string name="counter_label">عدد الإعجابات المنفذة</string>
    <string name="last_action_label">آخر إجراء قام به البوت</string>
    <string name="last_action_none">لا يوجد بعد</string>

    <!-- ===== Configuration ===== -->
    <string name="section_config">إعدادات البحث عن الأزرار</string>
    <string name="config_hint">يبحث البوت عن هذه النصوص داخل أي تطبيق على الشاشة. عدّل النصوص لتطابق ما يظهر في تطبيقك الهدف.</string>

    <string name="label_like_text">نص زر الإعجاب أو الاهتمام</string>
    <string name="hint_like_text">مثال: إهتمام أو اهتمام أو إعجاب</string>

    <string name="label_yes_text">نص زر التأكيد - نعم</string>
    <string name="hint_yes_text">مثال: نعم أو موافق أو تأكيد</string>

    <string name="label_close_text">نص زر الإغلاق - لرسائل النجاح والقيود</string>
    <string name="hint_close_text">مثال: إغلاق أو حسناً أو موافق</string>

    <string name="label_target_package">اسم حزمة التطبيق الهدف - اختياري</string>
    <string name="hint_target_package">اتركه فارغًا للعمل في أي تطبيق</string>

    <string name="label_profile_keywords">كلمات تدل على دخول الملف الشخصي بالخطأ - مفصولة بفاصلة</string>
    <string name="hint_profile_keywords">المؤهل التعليمي، الوزن، الطول</string>

    <string name="label_scan_interval">سرعة فحص الشاشة بالميلي ثانية</string>
    <string name="hint_scan_interval">مثال: 300 - الأقل أسرع لكن يستهلك بطارية أكثر</string>

    <string name="label_popup_wait">مدة انتظار ظهور النافذة المنبثقة بعد نقرة الإعجاب بالميلي ثانية</string>
    <string name="hint_popup_wait">مثال: 2000 أي ثانيتان - زدها إذا الإنترنت بطيء</string>

    <string name="label_idle_timeout">إيقاف تلقائي إذا لم يجد البوت أي زر إعجاب أو نعم لمدة (ثانية)</string>
    <string name="hint_idle_timeout">مثال: 30 - يتوقف بعد 30 ثانية من عدم وجود أزرار</string>

