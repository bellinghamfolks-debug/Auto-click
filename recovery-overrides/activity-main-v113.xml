<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/btn_start"
        android:textSize="19sp"
        android:contentDescription="@string/btn_start"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="إيقاف"
        android:textSize="19sp"
        android:contentDescription="إيقاف التشغيل"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/btn_open_accessibility"
        android:textSize="19sp"
        android:contentDescription="@string/btn_open_accessibility"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnShareDiagnostic"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="التشخيص"
        android:textSize="19sp"
        android:contentDescription="التشخيص" />

</LinearLayout>
