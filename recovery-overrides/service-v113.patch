+    private boolean looksLikeTargetScreen(List<AccessibilityNodeInfo> roots) {
+        keywordScanThisTick = 0;
+        List<String> needles = new ArrayList<>();
+        String like = normalizeArabic(config.likeText);
+        if (!like.isEmpty()) needles.add(like);
+        needles.add(normalizeArabic("الأعضاء"));
+        needles.add(normalizeArabic("المتواجدون الآن"));
+        needles.add(normalizeArabic("المتواجدون الان"));
+        if (config.profileKeywords != null) {
+            for (String k : config.profileKeywords) {
+                String n = normalizeArabic(k);
+                if (!n.isEmpty()) needles.add(n);
+            }
+        }
+        for (AccessibilityNodeInfo root : roots) {
+            if (containsAnyVisibleText(root, needles, 0)) return true;
+        }
+        return false;
+    }
 
