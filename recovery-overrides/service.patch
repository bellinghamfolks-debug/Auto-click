+    private boolean containsAnyVisibleText(AccessibilityNodeInfo node,
+                                           List<String> needles, int depth) {
+        if (node == null || depth > MAX_TREE_DEPTH) return false;
+        if (++keywordScanThisTick > MAX_NODES_PER_TICK) return false;
+        if (node.isVisibleToUser()) {
+            CharSequence text = node.getText();
+            CharSequence desc = node.getContentDescription();
+            if (text != null) {
+                String hay = normalizeArabic(text.toString());
+                for (String n : needles) if (hay.equals(n) || hay.contains(n)) return true;
+            }
+            if (desc != null) {
+                String hay = normalizeArabic(desc.toString());
+                for (String n : needles) if (hay.equals(n) || hay.contains(n)) return true;
+            }
+        }
+        int count = node.getChildCount();
+        for (int i = 0; i < count; i++) {
+            AccessibilityNodeInfo child = node.getChild(i);
+            if (child == null) continue;
+            track(child);
+            if (containsAnyVisibleText(child, needles, depth + 1)) return true;
         }
         return false;
     }
