+    private String getActivePackageName() {
+        AccessibilityNodeInfo active = null;
+        try {
+            active = getRootInActiveWindow();
+            if (active == null) return "";
+            track(active);
+            CharSequence pkg = active.getPackageName();
+            return pkg == null ? "" : pkg.toString();
+        } catch (Throwable t) {
+            return "";
+        }
+    }
+
+    private List<AccessibilityNodeInfo> rootsForPackage(
+            List<AccessibilityNodeInfo> roots, String packageName) {
+        List<AccessibilityNodeInfo> filtered = new ArrayList<>();
+        if (roots == null || packageName == null || packageName.isEmpty()) return filtered;
+        for (AccessibilityNodeInfo root : roots) {
+            if (root == null) continue;
+            CharSequence pkg = root.getPackageName();
+            if (pkg != null && packageName.equals(pkg.toString())) filtered.add(root);
+        }
+        return filtered;
     }
 
