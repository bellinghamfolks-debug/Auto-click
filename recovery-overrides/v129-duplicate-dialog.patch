+    // The app may put this blocking spinner directly over the duplicate dialog.
+    private boolean waitForInterestRequest(List<AccessibilityNodeInfo> roots, long now) {
+        if (now < loadingNextCheckMs) return true;
+        for (AccessibilityNodeInfo root : roots) {
+            List<AccessibilityNodeInfo> hits = root.findAccessibilityNodeInfosByText("جاري");
+            if (hits == null) continue;
+            for (AccessibilityNodeInfo hit : hits) track(hit);
+            for (AccessibilityNodeInfo hit : hits) {
+                if (hit == null || !hit.isVisibleToUser()) continue;
+                String msg = normalizeArabic(String.valueOf(hit.getText()) + " " + hit.getContentDescription());
+                if (!msg.contains("جاري") || !msg.contains("اضاف") ||
+                        !(msg.contains("العضو") || msg.contains("اهتمام"))) continue;
+                if (loadingNextCheckMs == 0L) diagEvent("INTEREST-LOADING");
+                loadingNextCheckMs = now + 450L;
+                loadingGoneSinceMs = 0L;
+                lastButtonFoundMs = now;
+                if (v126DuplicateSinceMs != 0L) v126DuplicateSinceMs = now;
+                return true;
+            }
+        }
+        if (loadingNextCheckMs != 0L) {
+            if (loadingGoneSinceMs == 0L) {
+                loadingGoneSinceMs = now;
+                loadingNextCheckMs = now + 450L;
+                return true;
+            }
+            loadingGoneSinceMs = loadingNextCheckMs = 0L;
+            diagEvent("INTEREST-LOADING-CLOSED");
+        }
+        return false;
+    }
