+        private void collectIndexedText(String query) {
+            if (query == null || query.isEmpty()) return;
+            HashSet<AccessibilityNodeInfo> seen = new HashSet<>();
+            for (AccessibilityNodeInfo root : roots) {
+                nativeQueries++;
+                List<AccessibilityNodeInfo> hits = root.findAccessibilityNodeInfosByText(query);
+                if (hits == null) continue;
+                // Every legacy node is owned by this tick, including hidden hits.
+                for (AccessibilityNodeInfo node : hits) track(node);
+                for (AccessibilityNodeInfo node : hits) {
+                    if (node == null || !seen.add(node)) continue;
+                    nativeCandidates++;
+                    Rect bounds = new Rect();
+                    node.getBoundsInScreen(bounds);
+                    if (!node.isVisibleToUser() || bounds.isEmpty() || bounds.bottom <= 0
+                            || bounds.top >= screenH || bounds.right <= 0 || bounds.left >= screenW) continue;
+                    addLabel(node, node.getText(), bounds);
+                    addLabel(node, node.getContentDescription(), bounds);
+                    visibleNodes++;
+                }
+            }
+            if (labels.size() >= SNAPSHOT_MAX_LABELS) truncated = true;
+        }
